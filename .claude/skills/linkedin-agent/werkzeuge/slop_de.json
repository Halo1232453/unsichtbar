 "structures": [
  {
   "id": "nicht-um-sondern",
   "regex": "(?i)\\bes geht nicht (?:nur |bloss |bloß |einfach )?um\\b[^.!?\\n]{2,80}?(?:,\\s*sondern\\b|[.!]\\s*es geht um\\b)",
   "name": "«Es geht nicht um X, sondern um Y»",
   "fix": "Sag das Y direkt. Die Gegenüberstellung ist das Erkennungszeichen."
  },
  {
   "id": "nicht-nur",
   "regex": "(?i)\\bnicht nur\\b[^.!?\\n]{2,80}\\bsondern auch\\b",
   "name": "«Nicht nur X, sondern auch Y»",
   "fix": "Zwei Sätze daraus machen oder die schwächere Hälfte streichen."
  },
  {
   "id": "das-ist-kein",
   "regex": "(?i)\\b(?:das|es|dies) ist (?:kein|keine|nicht)\\b[^.!?\\n]{2,60}[.!]\\s*(?:es|das|dies) ist\\b",
   "name": "«Das ist kein X. Das ist Y.»",
   "fix": "Mit Y anfangen. Die Umkehrung verrät die Maschine."
  },
  {
   "id": "enthuellungsfrage",
   "regex": "(?im)^\\s*(?:das ergebnis|der haken|das beste daran|der clou|die lösung|die loesung|der grund|die antwort|das problem|und jetzt|warum|wieso|der twist)\\?\\s*$",
   "name": "Ein-Wort-Enthüllungsfrage als eigene Zeile",
   "fix": "Direkt im Satz beantworten statt eine Enthüllung zu inszenieren."
  },
  {
   "id": "gelernt",
   "regex": "(?i)\\b(?:hier ist,? was (?:ich|wir) gelernt|das habe ich (?:daraus )?gelernt|das haben wir (?:daraus )?gelernt|was ich daraus gelernt habe|meine (?:wichtigsten )?learnings)\\b",
   "name": "«Das habe ich gelernt:»",
   "fix": "Die Lehre einfach sagen. Die Ankündigung streichen."
  },
  {
   "id": "dreier",
   "regex": "(?i)\\b\\w+, \\w+ und \\w+[.!]",
   "name": "Dreierreihe (A, B und C.)",
   "fix": "Zwei Punkte oder vier. Drei ist der Standardrhythmus der Maschine."
  },
  {
   "id": "rakete",
   "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
   "name": "Raketen- / Feuer- / Glühbirnen- / Funkel- / Zielscheiben-Emoji",
   "fix": "Höchstens ein Emoji, und keines von diesen fünf."
  },
  {
   "id": "emoji-liste",
   "regex": "(?m)(?:^[ \\t]*(?:\\u2705|\\U0001F449|\\U0001F539|\\U0001F538|\\u25B6\\uFE0F?|\\u27A1\\uFE0F?|\\u2714\\uFE0F?|\\U0001F4CC|\\U0001F447)[^\\n]*(?:\\n|$)){3,}",
   "name": "Emoji-Aufzählung (✅ 👉 🔹 ...)",
   "fix": "Normale Bindestriche oder ein kurzer Absatz."
  },
  {
   "id": "hashtag-wand",
   "regex": "(?:#\\w+[ \\t]*){5,}",
   "name": "Hashtag-Wand (5+)",
   "fix": "Drei Hashtags. Die Wand bringt auf LinkedIn nichts mehr."
  },
  {
   "id": "als-ki",
   "regex": "(?i)\\bals (?:eine )?KI(?![-\\w])|\\bals (?:ein )?Sprachmodell\\b",
   "name": "Selbstbezug des Modells",
   "fix": "Satz löschen."
  },
  {
   "id": "fazit",
   "regex": "(?im)^\\s*(?:fazit|zusammenfassend|abschliessend|abschließend|kurz gesagt|unterm strich|alles in allem|zum schluss)\\b",
   "name": "Aufsatz-Schluss («Fazit:», «Zusammenfassend»)",
   "fix": "Ein Beitrag braucht keinen Schlussabsatz. Streichen oder als echte Wendung schreiben."
  },
  {
   "id": "koeder",
   "regex": "(?im)(?:was denkt ihr|was meint ihr|wie seht ihr das|was sagt ihr|wie sehen sie das|was denken sie|was meinen sie|wer kennt(?:'s| es| das)|eure meinung|ihre meinung|stimmt ihr zu|stimmen sie zu|bin ich der einzige|bin ich die einzige|seht ihr das auch so|sehen sie das auch so)\\s*\\?[^\\S\\n]*\\S{0,3}[^\\S\\n]*$",
   "name": "Reflex-Engagement-Köder («Was denkt ihr?»)",
   "fix": "Eine Frage stellen, die nur dieser Beitrag stellen kann, zum konkreten Punkt darüber."
  },
  {
   "id": "freue-mich",
   "regex": "(?i)\\b(?:ich freue mich|wir freuen uns)\\b[^.!?\\n]{0,50}\\b(?:mitzuteilen|mitteilen|bekanntzugeben|bekannt zu geben|zu verkünden|verkünden|anzukündigen)\\b",
   "name": "«Wir freuen uns, mitteilen zu dürfen»",
